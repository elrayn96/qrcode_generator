# Servidor público
API_HOST=127.0.0.1
API_PORT=8080

# Comunicação interna
QR_ENGINE_URL=http://127.0.0.1:8001

# Ambiente de execução
# APP_ENV: development, test, production
# LOG_LEVEL: DEBUG, INFO, WARN, ERROR
APP_ENV=development
LOG_LEVEL=INFO

# Concorrência
# WORKER_COUNT: 1-256
# QUEUE_CAPACITY: 1-100000
WORKER_COUNT=2
QUEUE_CAPACITY=8

# Timeout dos pedidos: 1-300 segundos
REQUEST_TIMEOUT_SECONDS=15

# Cache: 0-86400 segundos
# O valor 0 desactiva a cache
CACHE_TTL_SECONDS=60

# Firebase
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=