
root = true

# Configuração global
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python
[*.py]
indent_size = 4

# Go
[*.go]
indent_style = tab
indent_size = 4

# Kotlin e Java
[*.{kt,kts,java}]
indent_size = 4

# Frontend
[*.{html,css,js,mjs,cjs}]
indent_size = 2

# Configurações e contratos
[*.{json,yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

# XML
[*.xml]
indent_size = 4

# Documentação
[*.md]
trim_trailing_whitespace = false

# Scripts PowerShell
[*.ps1]
indent_size = 4

# Scripts Windows
[*.{bat,cmd}]
end_of_line = crlf

# Makefile
[Makefile]
indent_style = tab
